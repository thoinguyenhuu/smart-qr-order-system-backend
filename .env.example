# Database
DB_URL=jdbc:postgresql://localhost:5432/smartqr
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Mail
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Application
APP_JWT_ACCESS_KEY=replace-with-a-long-random-secret
APP_JWT_REFRESH_KEY=replace-with-a-long-random-secret
APP_REGISTER_KEY=replace-with-a-long-random-secret
APP_FRONTEND_URL=http://localhost:5173

# AI
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Legacy fallback still supported by application.yaml
GOOGLE_API_KEY=

# SendGrid
SENDGRID_API_KEY=replace-with-your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=SmartQR Order System

# Docker Compose
POSTGRES_DB=smartqr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
BACKEND_PORT=8080
